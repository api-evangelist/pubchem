  "info": {
    "_postman_id": "19db0e22-26ce-4894-99c3-3987ed16c74f",
    "name": "PubChem PUG REST Compounds Utilities API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "PUG REST is a REST-style version of PUG (Power User Gateway), a web interface for accessing PubChem data and services. PUG REST provides access to the data in PubChem Compounds as well as specialized chemical structure search services.\n\nThe service supports various input formats including chemical names, SMILES strings, InChI identifiers, and direct database identifiers. It can return data in multiple formats including JSON, XML, CSV, SDF, and PNG images.\n\n\nContact Support:\n Email: pubchem-help@ncbi.nlm.nih.gov",
      "type": "text/plain"
    }
  }
